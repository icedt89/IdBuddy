{
  "name": "id-buddy",
  "author": "Jan Hafner",
  "version": "0.10.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.1.3"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "build": "pnpm run type-check && vite build",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "format": "prettier --write .",
    "generate-pwa-assets": "pwa-assets-generator",
    "all": "pnpm run test:run && pnpm run format && pnpm run generate-pwa-assets && pnpm run build"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@paralleldrive/cuid2": "^3.3.0",
    "@skorotkiewicz/snowflake-id": "^1.0.1",
    "@vueuse/core": "^14.3.0",
    "bson": "^7.2.0",
    "date-fns": "^4.2.1",
    "nanoid": "^5.1.11",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "ulidx": "^2.4.1",
    "uuid": "^14.0.0",
    "vue": "^3.5.34",
    "vuetify": "^4.0.7",
    "xid-ts": "^1.2.2"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^25.9.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "prettier": "^3.8.3",
    "sass-embedded": "^1.99.0",
    "typescript": "~6.0.3",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.13",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.1"
  }
}
